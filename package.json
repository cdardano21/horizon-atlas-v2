{
  "name": "horizon-atlas-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:catalog": "node scripts/check_catalog_quality.mjs",
    "check:references": "node scripts/check_internal_references.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "baseline:quality": "node scripts/build_destination_quality_baseline.mjs",
    "validate:quality": "npm run check:catalog && npm run check:references",
    "validate:all": "npm run lint && npm exec -- tsc --noEmit && npm run test && npm run test:e2e",
    "audit:production": "node scripts/production_readiness_audit.mjs",
    "audit:production:full": "npm run validate:all && npm run build && npm run audit:production",
    "build:command-center-seeds": "python3 scripts/build_command_center_seeds.py",
    "build:command-center-sql": "node scripts/build_command_center_merged_seeds.mjs && python3 scripts/build_command_center_seed_sql.py",
    "build:destination-card-facts": "node scripts/build_destination_card_facts.mjs",
    "apply:command-center-sql": "node scripts/apply_command_center_seed_sql.mjs",
    "expansion:coverage": "node scripts/build_expansion_coverage_report.mjs",
    "expansion:queue": "node scripts/build_expansion_ingestion_queue.mjs",
    "expansion:readiness": "node scripts/validate_expansion_readiness.mjs",
    "expansion:wave1": "node scripts/build_expansion_wave1_run_artifacts.mjs",
    "expansion:checklist": "node scripts/update_wave1_checklist_from_coverage.mjs",
    "expansion:refresh": "npm run expansion:coverage && npm run expansion:queue && npm run expansion:readiness && npm run expansion:wave1 && npm run expansion:checklist",
    "expansion:wave1:monthlyClimate:init": "node scripts/build_wave1_monthly_climate_input.mjs",
    "expansion:wave1:monthlyClimate:apply": "node scripts/apply_wave1_monthly_climate_ingestion.mjs",
    "expansion:wave1:costHousing:init": "node scripts/build_wave1_cost_housing_input.mjs",
    "expansion:wave1:costHousing:apply": "node scripts/apply_wave1_cost_housing_ingestion.mjs",
    "expansion:wave1:healthAirports:init": "node scripts/build_wave1_health_airports_input.mjs",
    "expansion:wave1:healthAirports:apply": "node scripts/apply_wave1_health_airports_ingestion.mjs",
    "expansion:wave1:visaTax:init": "node scripts/build_wave1_visa_tax_input.mjs",
    "expansion:wave1:visaTax:apply": "node scripts/apply_wave1_visa_tax_ingestion.mjs",
    "expansion:wave1:practicalInfo:init": "node scripts/build_wave1_practical_info_input.mjs",
    "expansion:wave1:practicalInfo:apply": "node scripts/apply_wave1_practical_info_ingestion.mjs",
    "expansion:wave1:applyFilled": "node scripts/apply_wave1_filled_categories.mjs",
    "expansion:wave1:completeness": "node scripts/build_wave1_input_completeness_report.mjs",
    "expansion:wave1:validateInputs": "node scripts/validate_wave1_input_files.mjs",
    "expansion:wave1:preflight": "npm run expansion:wave1:completeness && npm run expansion:wave1:applyFilled",
    "expansion:wave1:validateApplyReady": "node scripts/validate_wave1_input_files.mjs --require-populated",
    "expansion:wave1:researchPackets": "node scripts/build_wave1_research_source_packets.mjs",
    "expansion:wave1:workboard": "node scripts/build_wave1_research_workboard.mjs",
    "expansion:wave1:bundles": "node scripts/build_wave1_research_bundle_files.mjs",
    "expansion:wave1:sprints": "node scripts/build_wave1_research_sprints.mjs",
    "expansion:wave1:sprintExtracts": "node scripts/build_wave1_sprint_input_extracts.mjs",
    "expansion:wave1:planTemplate": "node scripts/build_wave1_sprint_plan_fill_template.mjs",
    "expansion:wave1:monthlyClimateTemplate": "node scripts/build_wave1_monthly_climate_fill_template.mjs",
    "expansion:wave1:sprint1ClimateTemplate": "node scripts/build_wave1_monthly_climate_fill_template.mjs --sprint=SPRINT_1",
    "expansion:wave1:sprint1CostHousingTemplate": "node scripts/build_wave1_sprint_plan_fill_template.mjs --sprint=SPRINT_1 --plan=costHousing",
    "expansion:wave1:sprint1HealthAirportsTemplate": "node scripts/build_wave1_sprint_plan_fill_template.mjs --sprint=SPRINT_1 --plan=healthAirports",
    "expansion:wave1:sprint1VisaTaxTemplate": "node scripts/build_wave1_sprint_plan_fill_template.mjs --sprint=SPRINT_1 --plan=visaTax",
    "expansion:wave1:sprint1PracticalInfoTemplate": "node scripts/build_wave1_sprint_plan_fill_template.mjs --sprint=SPRINT_1 --plan=practicalInfo",
    "expansion:wave1:sprint1AllTemplates": "npm run expansion:wave1:sprint1ClimateTemplate && npm run expansion:wave1:sprint1CostHousingTemplate && npm run expansion:wave1:sprint1HealthAirportsTemplate && npm run expansion:wave1:sprint1VisaTaxTemplate && npm run expansion:wave1:sprint1PracticalInfoTemplate",
    "expansion:wave1:applyTemplates": "node scripts/apply_wave1_sprint_fill_templates.mjs",
    "expansion:wave1:sprint1ApplyTemplates": "node scripts/apply_wave1_sprint_fill_templates.mjs --sprint=SPRINT_1",
    "expansion:wave1:sprintCycle": "node scripts/run_wave1_sprint_cycle.mjs",
    "expansion:wave1:sprint1Cycle": "npm run expansion:wave1:sprint1ApplyTemplates && npm run expansion:wave1:sprintMerge && npm run expansion:wave1:sprintPartialApply && npm run expansion:wave1:preflightStrict",
    "expansion:wave1:sprint2Cycle": "node scripts/run_wave1_sprint_cycle.mjs --sprint=SPRINT_2",
    "expansion:wave1:sprint3Cycle": "node scripts/run_wave1_sprint_cycle.mjs --sprint=SPRINT_3",
    "expansion:wave1:sprintMerge": "node scripts/merge_wave1_sprint_input_extracts.mjs",
    "expansion:wave1:sprintProgress": "node scripts/build_wave1_sprint_progress_report.mjs",
    "expansion:wave1:sprintPartialApply": "node scripts/apply_wave1_sprint_partial_to_merged.mjs",
    "expansion:wave1:sprint1PartialApply": "node scripts/apply_wave1_sprint_partial_to_merged.mjs --sprint=SPRINT_1",
    "expansion:wave1:opsStatus": "node scripts/build_wave1_ops_status.mjs",
    "expansion:wave1:focusReport": "node scripts/build_wave1_focus_report.mjs",
    "expansion:wave1:preflightStrict": "npm run expansion:wave1:researchPackets && npm run expansion:wave1:completeness && npm run expansion:wave1:workboard && npm run expansion:wave1:bundles && npm run expansion:wave1:sprints && npm run expansion:wave1:sprintExtracts && npm run expansion:wave1:sprintProgress && npm run expansion:wave1:validateApplyReady && npm run expansion:wave1:sprintPartialApply && npm run expansion:wave1:applyFilled && npm run expansion:wave1:opsStatus && npm run expansion:wave1:focusReport"
  },
  "dependencies": {
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
